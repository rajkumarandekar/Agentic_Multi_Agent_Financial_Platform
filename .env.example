GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Optional overrides
PDF_PATH=data/sample.pdf
CHROMA_PERSIST_DIR=chroma_store
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
GROQ_MODEL=llama3-8b-8192
# Supervisor routing/verification only -- a stronger model here matters more
# than anywhere else (one bad judgment call cascades into every downstream
# agent), and it's a single short call per turn so the cost is negligible.
# See orchestration/supervisor.py's own comment for the full rationale.
ROUTER_MODEL=llama-3.3-70b-versatile
TOP_K=4

# Phase 2
DB_PATH=data/shipments.db
MCP_DATA_DIR=data

# Phase 4 — LangSmith tracing (optional; app runs fine without these)
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_PROJECT=agentic-ai-platform

# Phase 3 — Research agent web search (optional; agent degrades gracefully
# with an explicit "unavailable" message if unset -- see agents/research_agent.py)
# TAVILY_API_KEY=your_tavily_api_key_here

# TEMPORARY: Gemini embeddings experiment, replacing HuggingFace for now
# (revertable -- see ingestion/pdf_ingest.py and orchestration/semantic_router.py)
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_EMBED_MODEL=models/gemini-embedding-001
